APP_NAME=gatelin
NODE_VERSION=24.11.0-alpine3.22
NODE_ENV=development
TZ=Europe/Paris
UID=1000
GID=1000
GATELIN_HOST=${APP_NAME}

ENV_NAME=local
DEFAULT_PORT=3000
SERVER_SCHEME=http://
STACK_NAME=${APP_NAME}-${ENV_NAME}

# Adminer
ADMINER_HOST=${APP_NAME}-adminer-${ENV_NAME}
ADMINER_VERSION=adminer:latest
ADMINER_PORT=8080

# Liquibase 
LIQUIBASE_VERSION=4.28.0-alpine
LIQUIBASE_DB_USER=liquibase
LIQUIBASE_DB_PWD=liquibAs3!
LIQUIBASE_LOG_LEVEL=INFO
LIQUIBASE_UPDATE=1
LIQUIBASE_SNAPSHOT=1
LIQUIBASE_COMMAND_CONTEXTS=v1,oauth
LIQUIBASE_ROLLBACK=0

# Postgres
POSTGRES_HOST=${APP_NAME}-postgres-${ENV_NAME}
POSTGRES_VERSION=postgres:16.2-alpine3.19
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_ROOT_USER=root
POSTGRES_ROOT_PWD=test123
POSTGRES_DBS=liquibase,gatelin

#TRAEFIK
TRAEFIK_HOST=${APP_NAME}-traefik-${ENV_NAME}
TRAEFIK_VERSION=3.6.4
TRAEFIK_ACCESSLOG=true
TRAEFIK_API_INSECURE=true
TRAEFIK_ENTRYPOINTS_WEB_ADDRESS=":80"
TRAEFIK_ENTRYPOINTS_WEB_FORWARDEDHEADERS_INSECURE=false
TRAEFIK_PROVIDERS_DOCKER_EXPOSEDBYDEFAULT=false
TRAEFIK_LOG_LEVEL="DEBUG"
TRAEFIK_PING=true
TRAEFIK_DASH_PORT=8083
TRAEFIK_PORT=8100

GATELIN_DB_NAME=gatelin
GATELIN_DB_USER=mdfvu
GATELIN_DB_PWD=gklkqt§
GATELIN_ACCESS_TOKEN_DURATION=600 #10 * 60 => 10 mins
GATELIN_REFRESH_TOKEN_DURATION=86400 #24 * 60 * 60 => 1 day
GATELIN_MIGRATION_SERVICE_NAME=ms-gateway-migration
GATELIN_MIGRATION_HOST=${APP_NAME}-${GATELIN_MIGRATION_SERVICE_NAME}-${ENV_NAME}
# password policy
GATELIN_PWD_MIN_LENGTH_LEGACY=9
GATELIN_PWD_MAX_LENGTH_LEGACY=64
GATELIN_PWD_NUMBERS_LEGACY=true
GATELIN_PWD_UPPERCASE_LEGACY=false
GATELIN_PWD_LOWERCASE_LEGACY=true
GATELIN_PWD_SYMBOLS_LEGACY=true

