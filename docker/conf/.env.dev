
APP_NAME=gatelin
TZ=Europe/Paris
LOCALE=fr-FR

UID=1000
GID=1000

NODE_VERSION=24.11.0-alpine3.22
NODE_ENV=development
HOME_PATH=/home/user/
GATELIN_HOST=${APP_NAME}

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gatelin
DB_USER=mdfvu
DB_PWD=gklkqt§

JWT_ACCESS_SECRET=your_access_secret_min_32_chars    # Secret for signing access tokens
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars  # Secret for signing refresh tokens


# ms_gateway
MSGATEWAY_SERVICE_NAME=ms-gateway
MSGATEWAY_MIGRATION_SERVICE_NAME=ms-gateway-migration
MSGATEWAY_MIGRATION_HOST=${APP_NAME}-${MSGATEWAY_MIGRATION_SERVICE_NAME}-${ENV_NAME}
MSGATEWAY_HOST=${APP_NAME}-${MSGATEWAY_SERVICE_NAME}-${ENV_NAME}
MSGATEWAY_URL=${SERVER_SCHEME}${MSGATEWAY_HOST}:${DEFAULT_PORT}
MSGATEWAY_NODE_VERSION=${NODE_VERSION}
MSGATEWAY_FOLDER=gateway
MSGATEWAY_DB_NAME=msgateway
MSGATEWAY_DB_USER=mdfvu
MSGATEWAY_DB_PWD=gklkqt§
MSGATEWAY_DB_MAX=50
MSGATEWAY_DB_VERSION=1
MSGATEWAY_ACCESS_TOKEN_DURATION=600 #10 * 60 => 10 mins
MSGATEWAY_REFRESH_TOKEN_DURATION=86400 #24 * 60 * 60 => 1 day
# password policy
MSGATEWAY_PWD_MIN_LENGTH_LEGACY=9
MSGATEWAY_PWD_MAX_LENGTH_LEGACY=64
MSGATEWAY_PWD_NUMBERS_LEGACY=true
MSGATEWAY_PWD_UPPERCASE_LEGACY=false
MSGATEWAY_PWD_LOWERCASE_LEGACY=true
MSGATEWAY_PWD_SYMBOLS_LEGACY=true
