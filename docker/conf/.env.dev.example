APP_NAME=gatelin
NODE_VERSION=24.15.0-alpine3.22
NODE_ENV=development
TZ=Europe/Paris
UID=1000
GID=1000
HOME_PATH=/home/user/
GATELIN_HOST=${APP_NAME}

ENV_NAME=local
DEFAULT_PORT=3000
SERVER_SCHEME=http://
SERVER_URL=localhost
STACK_NAME=${APP_NAME}-${ENV_NAME}

# Adminer
ADMINER_HOST=${APP_NAME}-adminer-${ENV_NAME}
ADMINER_VERSION=adminer:latest
ADMINER_PORT=8080

# Liquibase 
LIQUIBASE_VERSION=4.28.0-alpine
LIQUIBASE_DB_USER=liquibase
LIQUIBASE_DB_PWD=
LIQUIBASE_LOG_LEVEL=INFO
LIQUIBASE_UPDATE=1
LIQUIBASE_SNAPSHOT=1
LIQUIBASE_COMMAND_CONTEXTS=v1,oauth
LIQUIBASE_ROLLBACK=0

# Postgres
POSTGRES_HOST=${APP_NAME}-postgres-${ENV_NAME}
POSTGRES_VERSION=postgres:16.2-alpine3.19
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_ROOT_USER=root
POSTGRES_ROOT_PWD=
POSTGRES_DBS=liquibase,gatelin,foxnox

#TRAEFIK
TRAEFIK_HOST=${APP_NAME}-traefik-${ENV_NAME}
TRAEFIK_VERSION=3.6.4
TRAEFIK_ACCESSLOG=true
TRAEFIK_API_INSECURE=true
TRAEFIK_ENTRYPOINTS_WEB_ADDRESS=":80"
TRAEFIK_ENTRYPOINTS_WEB_FORWARDEDHEADERS_INSECURE=false
TRAEFIK_PROVIDERS_DOCKER_EXPOSEDBYDEFAULT=false
TRAEFIK_LOG_LEVEL="DEBUG"
TRAEFIK_PING=true
TRAEFIK_DASH_PORT=8083

#ADMIN
TRAEFIK_PORT=8100
TRAEFIK_PREFIX=/api
TRAEFIK_PUBLIC_URL=${SERVER_SCHEME}${SERVER_URL}:${TRAEFIK_PORT}${TRAEFIK_PREFIX}/

# Foxnox (published GHCR image; pin the tag until a stable release)
FOXNOX_VERSION=0.1.0-alpha.1
FOXNOX_HOST=${APP_NAME}-foxnox-${ENV_NAME}
FOXNOX_URL=${SERVER_SCHEME}${FOXNOX_HOST}:${DEFAULT_PORT}
FOXNOX_DB_NAME=foxnox
FOXNOX_DB_USER=
FOXNOX_DB_PWD=
FOXNOX_DB_JOB_USER=
FOXNOX_DB_JOB_PWD=
FOXNOX_PWD_SECRET=
FOXNOX_ACCESS_TOKEN_DURATION=600 #10 * 60 => 10 mins
FOXNOX_REFRESH_TOKEN_DURATION=86400 #24 * 60 * 60 => 1 day
FOXNOX_MIGRATION_SERVICE_NAME=foxnox-migration
FOXNOX_MIGRATION_HOST=${APP_NAME}-${FOXNOX_MIGRATION_SERVICE_NAME}-${ENV_NAME}
# The foxnox image bundles its own Angular admin UI on a dedicated port. The
# published image runs NODE_ENV=production, where Foxnox refuses to boot unless
# ADMIN_PORT is a valid port — so this must stay set even if you never open the UI.
FOXNOX_ADMIN_PORT=4300
FOXNOX_ADMIN_BASE_PATH=/foxnox
# Browser-facing workflow pages (Traefik /api/foxnox → Foxnox after strip-prefix).
WEB_PUBLIC_BASE=/api/foxnox/web
WEB_PUBLIC_ORIGIN=${SERVER_SCHEME}${SERVER_URL}:${TRAEFIK_PORT}
# WEB_LOGIN_RESUME_URL is set in the Admin section below (needs ADMIN_BASE_PATH).

# Outbound mail (Mailpit in local Docker)
MAILPIT_HOST=${APP_NAME}-mailpit-${ENV_NAME}
MAILPIT_VERSION=latest
MAILPIT_UI_PORT=8025
SMTP_HOST=${MAILPIT_HOST}
SMTP_PORT=1025
SMTP_SECURE=false
# Quoted: scripts source this file, and bare <> would be shell redirections.
SMTP_FROM="Foxnox <noreply@localhost>"

# ms_user
MSUSER_SERVICE_NAME=ms-user-mock
MSUSER_HOST=${APP_NAME}-${MSUSER_SERVICE_NAME}-${ENV_NAME}
MSUSER_URL=${SERVER_SCHEME}${MSUSER_HOST}:${DEFAULT_PORT}
MSUSER_SEARCH_URL=${MSUSER_URL}/users/users/search

# Gatelin
GATELIN_DB_NAME=gatelin
GATELIN_DB_USER=
GATELIN_DB_PWD=
GATELIN_DB_JOB_USER=
GATELIN_DB_JOB_PWD=
GATELIN_TOKEN_SECRET=
GATELIN_PWD_CHECK_URL=${FOXNOX_URL}/foxnox/compare
# Empty = skip mid-login challenges; password check still runs.
GATELIN_PWD_CHALLENGES_URL=${FOXNOX_URL}/foxnox/challenges
GATELIN_PWD_TRUSTED_DEVICES_URL=${FOXNOX_URL}/foxnox/devices/verify
GATELIN_PWD_LOGIN_TICKET_URL=${FOXNOX_URL}/foxnox/login-tickets/redeem
GATELIN_USER_SEARCH_URL=${MSUSER_SEARCH_URL}
GATELIN_ACCESS_TOKEN_DURATION=600 #10 * 60 => 10 mins
GATELIN_REFRESH_TOKEN_DURATION=86400 #24 * 60 * 60 => 1 day
GATELIN_REFRESH_TOKEN_COOKIE=true
# Max login/refresh attempts per IP per 15 min (default 20 in prod; raise in local/e2e)
GATELIN_SESSION_RATE_LIMIT_MAX=1000
# Max /gatelin/* admin API calls per consumer per minute (IP if unauthenticated; default 300 in prod)
GATELIN_ADMIN_RATE_LIMIT_MAX=10000
# Max proxied HTTP/WS-handshake calls per consumer per minute (IP if public; default 200 in prod)
GATELIN_PROXY_RATE_LIMIT_MAX=10000
# Abort a downstream call after this many ms so a hung upstream cannot pile up (default 30000)
GATELIN_UPSTREAM_TIMEOUT_MS=30000
GATELIN_MIGRATION_SERVICE_NAME=${APP_NAME}-migration
GATELIN_MIGRATION_HOST=${APP_NAME}-${GATELIN_MIGRATION_SERVICE_NAME}-${ENV_NAME}
# password policy
GATELIN_PWD_MIN_LENGTH_LEGACY=9
GATELIN_PWD_MAX_LENGTH_LEGACY=64
GATELIN_PWD_NUMBERS_LEGACY=true
GATELIN_PWD_UPPERCASE_LEGACY=false
GATELIN_PWD_LOWERCASE_LEGACY=true
GATELIN_PWD_SYMBOLS_LEGACY=true

# Dozzle
DOZZLE_HOST=${APP_NAME}-dozzle-${ENV_NAME}
DOZZLE_PORT=8080

# Swagger
SWAGGER_HOST=${APP_NAME}-swagger-${ENV_NAME}

# Website (docs)
WEBSITE_HOST=${APP_NAME}-website-${ENV_NAME}

# Admin
ADMIN_HOST=${APP_NAME}-admin-${ENV_NAME}
# Path prefix Traefik routes to the admin UI and the admin app itself serves under.
# Prod bakes a fixed placeholder at build time and rewrites <base href> at runtime
# from this env var (see src/admin-server.js) — no rebuild needed there.
# Dev's `ng serve` has no such runtime layer: it bakes baseHref/servePath from
# admin/angular.json at serve time, so this must match angular.json's "/admin" or
# you must edit angular.json to match.
ADMIN_BASE_PATH=/gatelin
ADMIN_PORT=4200
# Optional. When set, the login page shows a "Mot de passe oublié ?" link to this URL.
# Local Foxnox: /api/foxnox/web/recover — Traefik routes /api/foxnox to Foxnox.
ADMIN_PASSWORD_RECOVERY_URL=/api/foxnox/web/recover
# Optional. localStorage key for the access token (default: sso_access_token).
# Must match Foxnox admin's value when both are deployed on the same origin.
ADMIN_SSO_TOKEN_KEY=gatelin_sso_access_token
ADMIN_LOGIN_URL=${TRAEFIK_PUBLIC_URL}/gatelin/consumers
ADMIN_ME_URL=${TRAEFIK_PUBLIC_URL}/users/users/me
ADMIN_NODE_VERSION=${NODE_VERSION}
ADMIN_URL=${SERVER_SCHEME}${ADMIN_HOST}:${ADMIN_PORT}${ADMIN_BASE_PATH}/
# Where a completed mid-login challenge (Foxnox) sends the browser back with ?ticket=…
WEB_LOGIN_RESUME_URL=${SERVER_SCHEME}${SERVER_URL}:${TRAEFIK_PORT}${ADMIN_BASE_PATH}/login

# Admin E2E (Playwright, on-demand via `scripts/e2e.sh` or the `e2e` compose profile).
# Pin PLAYWRIGHT_VERSION to whatever admin/package.json's @playwright/test resolves to;
# the container image tag is mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble.
PLAYWRIGHT_VERSION=1.62.1
ADMIN_E2E_HOST=${APP_NAME}-admin-e2e-${ENV_NAME}
# URL the e2e container polls + Playwright uses as baseURL. Points at Traefik
# on the internal network (port 80 is Traefik's default web entrypoint),
# so tests exercise the same routing path a real browser hits.
ADMIN_E2E_BASE_URL=http://traefik${ADMIN_BASE_PATH}/

#npm registry
NPM_REGISTRY_DOMAIN=
NPM_REGISTRY_NODE=
NPM_REGISTRY_USER=
NPM_REGISTRY_TOKEN=
NPM_REGISTRY_URL=
NPMRC=""
