{
	"name": "gatelin",
	"version": "0.1.0-alpha.7",
	"description": "Backend for Frontend (BFF): an application API layer behind a reverse proxy, with JWT sessions, RBAC, and authenticated forwarding to internal microservices.",
	"keywords": [
		"bff",
		"backend-for-frontend",
		"jwt",
		"rbac",
		"acl",
		"express"
	],
	"main": "src/server.js",
	"type": "module",
	"scripts": {
		"start": "node src/server.js",
		"dev": "node --watch src/server.js",
		"test": "NODE_OPTIONS='--experimental-vm-modules' jest",
		"test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format src/",
		"format:fix": "biome format --write src/"
	},
	"author": "ALTEN",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ALTEN-group/Gatelin.git"
	},
	"bugs": {
		"url": "https://github.com/ALTEN-group/Gatelin/issues"
	},
	"homepage": "https://github.com/ALTEN-group/Gatelin#readme",
	"dependencies": {
		"@dwtechs/antity-pgsql": "0.23.0",
		"@dwtechs/checkard": "3.6.1",
		"@dwtechs/errandler-express": "0.1.1",
		"@dwtechs/healix-express": "0.2.0",
		"@dwtechs/servpico-express": "0.3.1",
		"@dwtechs/sparray": "0.2.1",
		"@dwtechs/toker-express": "0.9.0",
		"@dwtechs/winstan": "0.7.1",
		"@dwtechs/winstan-plugin-express-perf": "0.3.0",
		"cookie-parser": "1.4.7",
		"express": "5.2.1",
		"express-rate-limit": "8.6.2",
		"safe-regex2": "5.1.1"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/preset-env": "7.29.7",
		"@biomejs/biome": "2.5.8",
		"@types/jest": "30.0.0",
		"@types/node": "26.2.0",
		"babel-jest": "30.4.1",
		"jest": "30.4.2",
		"supertest": "7.2.2"
	}
}
