{
  "name": "httpclient",
  "version": "1.0.0",
  "description": "HTTP client",
  "main": "http.js",
  "scripts": {
    "dev": "nodemon -e js -x \"npm run build\"",
    "dev-poll": "nodemon -e js -x \"npm run build\" -L",
    "prebuild": "npm run test",
    "build": "npm pack --pack-destination ../../packs/http/",
    "postbuild": "cd ../../../app/ && npm i httpclient --force --nofund --no-audit",
    "test": "echo \"Error: no test specified\""
  },
  "author": "lcluber",
  "license": "ISC",
  "files": ["http.js"],
  "dependencies": {
    "@dwtechs/winstan": "0.4.0",
    "axios": "1.7.4"
  },
  "devDependencies": {
    "nodemon": "2.0.22"
  },
  "bundledDependencies": ["axios"]
}
